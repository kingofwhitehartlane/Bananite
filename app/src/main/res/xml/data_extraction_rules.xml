<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Explicitly include the DataStore file -->
        <include domain="datastore" path="user_prefs.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <include domain="datastore" path="user_prefs.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>